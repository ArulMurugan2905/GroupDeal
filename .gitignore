# ==============================================================================
# GroupDeal - Industrial Git Ignore Specification
# ==============================================================================

# --- Android & Gradle ---
*.iml
.gradle/
.kotlin/
build/
**/build/
android/app/build/
android/.gradle/
android/.kotlin/
captures/
.externalNativeBuild/
.cxx/
local.properties
**/local.properties

# --- Android Studio / IntelliJ IDEA ---
.idea/
*.ipr
*.iws
out/
.navigation/

# --- Android Signing & Secrets (Never commit production credentials) ---
*.jks
*.keystore
debug.keystore
my-upload-key.jks
.env
**/.env
!.env.example
**/!*.env.example
service-account*.json

# --- Node / TypeScript Packages ---
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/

# --- Firebase ---
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# --- Archives & Large Media (>100MB rejected by GitHub) ---
*.zip
*.tar.gz
*.7z
*.mp4
reports/*.mp4
GroupDeal_Project_Video.mp4

# --- Operating System & Editor Artifacts ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*~
*.bak

# --- Scratch & Temporary ---
scratch/
scratch_remote/
tmp/
temp/
